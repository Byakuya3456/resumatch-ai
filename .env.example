# .env.example — copy to .env and fill in your values
# cp .env.example .env

# ── Core & Database ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobmatcher
MONGODB_URI=mongodb://localhost:27017/
PORT=5000
FLASK_DEBUG=0
SECRET_KEY=change-me-in-production

# ── LLM Configuration (Local Ollama vs External Cloud API) ────
# Provider options: "ollama" (default local), "openai", "openrouter", "groq", "deepseek", "custom"
LLM_PROVIDER=ollama

# Required if using cloud providers (OpenAI, OpenRouter, Groq, DeepSeek)
LLM_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Optional: custom base URL (defaults automatically based on LLM_PROVIDER)
# LLM_BASE_URL=https://api.openai.com/v1

# Target Model:
# For Ollama: "hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M" or "llama3.2:3b"
# For OpenAI: "gpt-4o-mini"
# For OpenRouter: "qwen/qwen-2.5-7b-instruct" or "deepseek/deepseek-chat"
# For Groq: "llama-3.3-70b-versatile"
LLM_MODEL=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
LLM_TIMEOUT=120

# ── Local Ollama Settings (when LLM_PROVIDER=ollama) ─────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
OLLAMA_TIMEOUT=120

# ── Embedding model ────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ── RAG ───────────────────────────────────────────────────
RAG_TOP_K=15
LLM_TOP_K=5

# ── Parsers ───────────────────────────────────────────────
RAW_TEXT_MAX_CHARS=0

# ── External APIs ─────────────────────────────────────────
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# ── Future phases ─────────────────────────────────────────
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
